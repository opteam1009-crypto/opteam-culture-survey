# ── 데이터베이스 (Vercel > Storage > Neon 연결 시 자동 주입됨) ─────────────
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── 대시보드 로그인 ───────────────────────────────────────────────────────
# 대표이사 / 인사책임자 각각 다른 비밀번호를 쓰세요. 권한에 따라 열람 범위가 갈립니다.
DASHBOARD_CEO_PASSWORD=바꾸세요-대표이사용
DASHBOARD_HR_PASSWORD=바꾸세요-인사책임자용
# 세션 쿠키 서명 키 (아무 랜덤 문자열 32자 이상)
SESSION_SECRET=바꾸세요-랜덤문자열-32자이상-abcdefghijklmnop

# ── 제출 알림 메일 ────────────────────────────────────────────────────────
NOTIFY_EMAILS=opteam1009@gmail.com

# 방법 1) Resend (권장) — https://resend.com 에서 API 키 발급, 무료 월 3,000통
RESEND_API_KEY=
MAIL_FROM=사내설문 <onboarding@resend.dev>

# 방법 2) Gmail SMTP — Google 계정 > 보안 > 앱 비밀번호 생성 후 사용
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 둘 다 비워두면 메일은 발송되지 않지만 알림 내용이 DB(notification_log)에 쌓여
# 대시보드에서 확인할 수 있습니다. 데이터는 유실되지 않습니다.
