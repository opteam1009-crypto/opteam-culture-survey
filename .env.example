# 주의: Vercel 은 프로젝트를 import 할 때 이 파일을 읽어 환경변수를 자동 생성합니다.
# 아래 CHANGE_ME_ 로 시작하는 값은 앱이 "설정되지 않음"으로 취급해 거부하므로,
# 배포 후 Vercel 환경변수에서 실제 값으로 반드시 교체해야 합니다.

# ── 데이터베이스 (Vercel > Storage > Neon 연결 시 자동 주입됨) ─────────────
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── 대시보드 로그인 ───────────────────────────────────────────────────────
# 대표이사 / 인사책임자 각각 다른 비밀번호를 쓰세요. 권한에 따라 열람 범위가 갈립니다.
# 둘 중 하나만 등록해도 그 계정으로는 로그인할 수 있습니다.
DASHBOARD_CEO_PASSWORD=CHANGE_ME_대표이사용_비밀번호
DASHBOARD_HR_PASSWORD=CHANGE_ME_인사책임자용_비밀번호
# 세션 쿠키 서명 키 (선택) — 비워두면 DATABASE_URL 에서 자동으로 파생됩니다.
# 직접 지정하려면 32자 이상의 랜덤 문자열을 넣으세요. 값을 바꾸면 기존 로그인은 풀립니다.
# SESSION_SECRET=

# ── 제출 알림 메일 ────────────────────────────────────────────────────────
NOTIFY_EMAILS=CHANGE_ME@example.com

# 방법 1) Resend (권장) — https://resend.com 에서 API 키 발급, 무료 월 3,000통
RESEND_API_KEY=
MAIL_FROM=사내설문 <onboarding@resend.dev>

# 방법 2) Gmail SMTP — Google 계정 > 보안 > 앱 비밀번호 생성 후 사용
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 둘 다 비워두면 메일은 발송되지 않지만 알림 내용이 DB(notification_log)에 쌓여
# 대시보드에서 확인할 수 있습니다. 데이터는 유실되지 않습니다.
